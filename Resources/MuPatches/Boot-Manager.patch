 extern UINT32  mNarrowFontSize;
 
+//
+// Kettle: integer upscale for console text.
+//
+// The built-in font is 8x19 pixels per cell, which on a 1116x2480 panel gives
+// 139 columns x 130 rows -- correct, but far too small to read at arm's length
+// (for example when the phone is sitting at boot-menu distance). Text is still
+// laid out in native glyph cells: each run is rendered once at 1x and then
+// replicated N x N when composited, so wrapping, cursor and scroll arithmetic
+// stay in the same units. The stock 8x19 cell is small enough to read only at
+// very close range on a high-DPI panel.
+//
+//
+// Console cell size in pixels, derived from the panel rather than as a
+// multiple of the 8x19 built-in glyph cell.
+//
+// UEFI requires mode 0 to be 80x25, and applications such as
+// BootManagerMenuApp search for the PcdSetupConOutColumn/Row mode by size.
+// An integer 2x scale gave 69 columns, so 80x25 disappeared and the boot menu
+// stopped being drawn. 80 * 13 = 1040 fits the 1116px panel, which keeps mode
+// 0 spec-compliant while still making text about 1.6x wider and 2x taller.
+//
+//
+// Runtime so the settings screen can change it and have the choice persist.
+// Defaults to the size that still fits 80 columns on a 1116px panel.
+//
+#define KETTLE_DEFAULT_CELL_WIDTH   13
+#define KETTLE_DEFAULT_CELL_HEIGHT  38
+
+//
+// Upper bounds for the stack scratch buffer in FlushCursor, which must be a
+// compile-time size. The live cell size is clamped to these.
+//
+#define KETTLE_MAX_CELL_WIDTH       32
+#define KETTLE_MAX_CELL_HEIGHT      64
+
+extern UINTN  mKettleCellWidth;
+extern UINTN  mKettleCellHeight;
+
+#define CONSOLE_GLYPH_WIDTH   mKettleCellWidth
+#define CONSOLE_GLYPH_HEIGHT  mKettleCellHeight
+
+//
+// Persisted settings, shared by name and GUID with PlatformBootManagerLib.
+// Layout must stay in sync with BootManagerLib/Settings.c.
+//
+#define KETTLE_SETTINGS_SIGNATURE  SIGNATURE_32 ('K', 'T', 'L', 'S')
+
+typedef struct {
+  UINT32    Signature;
+  UINT32    Version;
+  UINT32    ForceMenu;
+  UINT32    ConsoleScale;
+} KETTLE_SETTINGS;
+
+//
+// Console scale index -> cell size. Index 0 is the stock 8x19 cell.
+//
+typedef struct {
+  UINT16    Width;
+  UINT16    Height;
+} KETTLE_CELL_SIZE;
+
