+//
+// Kettle: console cell size in pixels. Runtime rather than a macro so the
+// settings screen can change it and have the choice persist across boots.
+//
+UINTN  mKettleCellWidth  = KETTLE_DEFAULT_CELL_WIDTH;
+UINTN  mKettleCellHeight = KETTLE_DEFAULT_CELL_HEIGHT;
+
+STATIC EFI_GUID  mKettleSettingsGuid = {
+  0x2a7d61f4, 0x8c35, 0x4b92, { 0x9e, 0x14, 0x6d, 0x08, 0x53, 0xab, 0x7f, 0x21 }
+};
+
+STATIC CONST KETTLE_CELL_SIZE  mKettleCellSizes[] = {
+  { 8,  19 },
+  { 13, 38 },
+  { 16, 38 },
+  { 19, 38 },
+};
+
+#define KETTLE_CELL_SIZE_COUNT  (sizeof (mKettleCellSizes) / sizeof (mKettleCellSizes[0]))
+
+/**
+  Kettle: apply the persisted console cell size.
+
+  Called before the text mode table is built, because the cell size decides how
+  many columns and rows exist. Falls back to the default when the variable is
+  absent, which is the state on a freshly flashed device.
+**/
+STATIC
+VOID
+KettleApplyConsoleScale (
+  VOID
+  )
+{
+  EFI_STATUS       Status;
+  KETTLE_SETTINGS  Settings;
+  UINTN            Size;
+  UINT32           Index;
+
+  Size   = sizeof (Settings);
+  Status = gRT->GetVariable (
+                  L"KettleSettings",
+                  &mKettleSettingsGuid,
+                  NULL,
+                  &Size,
+                  &Settings
+                  );
+  if (EFI_ERROR (Status) || (Size < sizeof (Settings)) ||
+      (Settings.Signature != KETTLE_SETTINGS_SIGNATURE))
+  {
+    return;
+  }
+
+  Index = Settings.ConsoleScale;
+  if (Index >= KETTLE_CELL_SIZE_COUNT) {
+    Index = 1;
+  }
+
+  mKettleCellWidth  = mKettleCellSizes[Index].Width;
+  mKettleCellHeight = mKettleCellSizes[Index].Height;
+}
